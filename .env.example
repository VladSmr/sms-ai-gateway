# Example environment file for the SMS -> GigaChat gateway.
# Copy to .env and fill in the values: cp .env.example .env
# Secrets live here only; never commit .env to git.

# ---------------------------------------------------------------------------
# Deployment (docker-compose.yml / Caddyfile)
# ---------------------------------------------------------------------------
# Root domain for Caddy (subdomains sms.DOMAIN and app.DOMAIN are derived).
# Set this before running `docker compose up`.
# IMPORTANT: create DNS A-records BEFORE starting:
#   sms.example.com  -> <YOUR_VPS_IP>
#   app.example.com  -> <YOUR_VPS_IP>
DOMAIN=example.com

# ---------------------------------------------------------------------------
# MariaDB for the android-sms-gateway Go server
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change_me_strong_password
MYSQL_DB_USER=gateway
MYSQL_DB_PASSWORD=change_me_strong_password

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Log level for the app container: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Step 2 - Webhook receiver (active)
# ---------------------------------------------------------------------------
# HMAC-SHA256 signing key for webhook verification (headers X-Signature /
# X-Timestamp).  Also the "Signing Key" entered in the phone app
# (Settings -> Webhooks -> Signing Key).
GATEWAY_HMAC_SECRET=

# ---------------------------------------------------------------------------
# Step 3 - Go server (android-sms-gateway/server v1.47.4)
# ---------------------------------------------------------------------------
# Private token for device registration in private mode.  The phone app
# (Settings -> Cloud Server -> Private Token) must send the SAME value.
# After the phone first connects, the Go server auto-generates per-device
# username/password credentials (visible in the phone app's Home screen).
# Those generated credentials are used as GATEWAY_USERNAME / GATEWAY_PASSWORD
# for our app's 3rd-party API calls.
GATEWAY_PRIVATE_TOKEN=

# ---------------------------------------------------------------------------
# Step 4 - GigaChat client (active)
# ---------------------------------------------------------------------------
# GigaChat OAuth authorization key (sent as "Authorization: Basic <...>"
# to ngw.devices.sberbank.ru:9443/api/v2/oauth together with RqUID).
GIGACHAT_AUTH_KEY=
# Set to true to run without any keys/network: LLM replies become
# "(mock) <your message>" echoes (tests and local smoke runs).
MOCK_LLM=
# GigaChat API key, if required for your account type.
GIGACHAT_API_KEY=

# ---------------------------------------------------------------------------
# Step 5 - Reply sending, Telegram, watchdog (active)
# ---------------------------------------------------------------------------
# Credentials for the Go server's 3rd-party API (Basic auth).
# These are the username/password generated by the Go server on first
# phone connection (displayed in the phone app's Home screen under
# "Cloud Server" credentials).
# The phone app generates these; we use them to POST /api/3rdparty/v1/messages.
GATEWAY_USERNAME=
GATEWAY_PASSWORD=
# Set to true to skip real HTTP sends: "Gateway mock send" is logged.
MOCK_GATEWAY=
# Telegram bot alerts (create with @BotFather, get chat_id via getUpdates).
# Empty values = log-only alerts (pipeline keeps working without Telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=